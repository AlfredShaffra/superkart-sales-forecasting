{
  "name": "SuperKart deployment",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [7860, 8501],
  "portsAttributes": {
    "7860": {"label": "SuperKart Flask API", "onAutoForward": "notify"},
    "8501": {"label": "SuperKart Streamlit UI", "onAutoForward": "openBrowser"}
  },
  "postCreateCommand": "docker compose up --build -d"
}
